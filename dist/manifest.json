{
  "manifest_version": 3,
  "name": "Jira AI Health Dashboard",
  "description": "AI-style Jira dashboard with project health, bug trends, and agile insights.",
  "version": "1.0.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Jira AI Dashboard"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "identity"],
  "host_permissions": [
    "https://auth.atlassian.com/*",
    "https://api.atlassian.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
